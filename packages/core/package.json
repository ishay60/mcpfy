{
  "name": "@mcpfy/core",
  "version": "0.0.1",
  "description": "Core runtime for mcpfy: Connector interface, server, transports, and the non-bypassable security pipeline.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./transports/stdio": {
      "types": "./dist/transports/stdio.d.ts",
      "import": "./dist/transports/stdio.js"
    },
    "./transports/streamable-http": {
      "types": "./dist/transports/streamable-http.d.ts",
      "import": "./dist/transports/streamable-http.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "typescript": "^6.0.3",
    "vitest": "^2.1.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
