{
  "name": "@mcpfy/connector-sql",
  "version": "0.0.1",
  "description": "Shared SQL connector for mcpfy with Postgres, MySQL/MariaDB, and SQLite dialects. Read-only-by-default with per-dialect enforcement.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@mcpfy/core": "workspace:^",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.4.1",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "@types/better-sqlite3": "^7.6.11",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
