{
  "mcpServers": {
    "mcpolyglot": {
      "command": "npx",
      "args": [
        "-y",
        "@mcpolyglot/cli",
        "serve",
        "--config",
        "/abs/path/to/examples/postgres/mcpolyglot.config.ts"
      ],
      "env": {
        "DATABASE_URL": "postgres://user:pass@localhost:5432/mydb"
      }
    }
  }
}
