{
  "mcpServers": {
    "mcpolyglot": {
      "command": "npx",
      "args": [
        "-y",
        "@mcpolyglot/cli",
        "serve",
        "--config",
        "/abs/path/to/examples/mongo/mcpolyglot.config.ts"
      ],
      "env": {
        "MONGO_URL": "mongodb://localhost:27017/app"
      }
    }
  }
}
